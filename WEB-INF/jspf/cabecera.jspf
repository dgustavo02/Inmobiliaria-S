<%@ page pageEncoding="UTF-8" %>
<%--
    cabecera.jspf - Fragmento de encabezado HTML y navegacion principal
    Proyecto: Portal Inmobiliario
    Ubicacion: /WEB-INF/jspf/cabecera.jspf
--%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (request.getAttribute("tituloPagina") != null) ? request.getAttribute("tituloPagina") : "Portal Inmobiliario" %></title>
    
    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --navy-primary: #0b192c;
            --red-accent: #e63946;
            --red-hover: #c92a37;
            --bg-light: #f8f9fa;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #2b2d42;
            background-color: var(--bg-light);
        }

        .top-bar {
            background-color: var(--navy-primary);
            color: #a0aec0;
            font-size: 0.85rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .top-bar a {
            color: #e2e8f0;
            text-decoration: none;
        }

        .top-bar a:hover {
            color: var(--red-accent);
        }

        .navbar {
            background-color: #ffffff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--navy-primary);
        }

        .highlight-text {
            color: var(--red-accent);
        }

        .nav-link {
            color: #4a5568;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .nav-link:hover {
            color: var(--red-accent);
        }

        .btn-auth {
            background-color: var(--red-accent);
            color: #ffffff;
            font-weight: 700;
            border-radius: 6px;
        }

        .btn-auth:hover {
            background-color: var(--red-hover);
            color: #ffffff;
        }
    </style>
</head>
<body>

    

    <!-- Menú de Navegación Principal -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand fs-4" href="<%= request.getContextPath() %>/index.jsp">
                BUCARAMANGA INMOBILIARIA <span class="highlight-text">LTDA.</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav ms-auto me-lg-3">
                    <li class="nav-item">
                        <a class="nav-link" href="<%= request.getContextPath() %>/index.jsp">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= request.getContextPath() %>/index.jsp#inmuebles">Propiedades</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a href="<%= request.getContextPath() %>/login.jsp" class="btn btn-auth btn-sm px-3 py-2 text-decoration-none">
                        <i class="fa-solid fa-user me-1"></i> Iniciar Sesion
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container my-4">