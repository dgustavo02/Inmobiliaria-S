<%@ page contentType="text/html;charset=UTF-8" language="java" %>

<%
    /*
     * ============================================================
     * CABECERA GENERAL
     * ============================================================
     */

    String ctxNav = request.getContextPath();

    /*
     * La cabecera NO depende de tituloPagina.
     * Todas las páginas utilizarán este título general.
     */
    String tituloEscNav = "Inmobiliaria VSC";

    /*
     * Recuperar la sesión existente.
     *
     * IMPORTANTE:
     * getSession(false) NO crea una sesión nueva.
     */
    javax.servlet.http.HttpSession sesionNav =
            request.getSession(false);

    Object idUsuarioNav = null;
    Object nombreActualNavObj = null;
    Object rolActualNavObj = null;

    if (sesionNav != null) {
        idUsuarioNav = sesionNav.getAttribute("idUsuario");
        nombreActualNavObj = sesionNav.getAttribute("nombreCompleto");
        rolActualNavObj = sesionNav.getAttribute("rol");
    }

    boolean usuarioAutenticadoNav = (idUsuarioNav != null);

    String nombreActualNav =
            nombreActualNavObj != null
            ? nombreActualNavObj.toString()
            : "";

    String rolActualNav =
            rolActualNavObj != null
            ? rolActualNavObj.toString()
            : "";

    /*
     * Escape HTML.
     */
    String nombreEscNav = nombreActualNav
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace("\"", "&quot;")
            .replace("'", "&#39;");

    String rolEscNav = rolActualNav
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace("\"", "&quot;")
            .replace("'", "&#39;");
%>

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        <%= tituloEscNav %>
    </title>

    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet">

    <link
        href="<%= ctxNav %>/css/estilos.css?v=13"
        rel="stylesheet">

</head>

<body class="bg-light">


<!-- ============================================================
     NAVBAR
     ============================================================ -->

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

    <div class="container-fluid">

        <!-- LOGO -->

        <a class="navbar-brand fw-bold"
           href="<%= response.encodeURL(ctxNav + "/index.jsp") %>">

            <i class="bi bi-houses-fill me-1"></i>

            Inmobiliaria VSC

        </a>


        <!-- BOTÓN RESPONSIVE -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navMenu"
            aria-controls="navMenu"
            aria-expanded="false"
            aria-label="Mostrar menú">

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- MENÚ -->

        <div class="collapse navbar-collapse" id="navMenu">

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                <!-- =================================================
                     CATÁLOGO
                     ================================================= -->

                <li class="nav-item">

                    <a class="nav-link"
                       href="<%= response.encodeURL(ctxNav + "/catalogo.jsp") %>">

                        <i class="bi bi-search me-1"></i>

                        Catálogo

                    </a>

                </li>


                <!-- =================================================
                     PANEL
                     ================================================= -->

                <% if (usuarioAutenticadoNav) { %>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/panel.jsp") %>">

                            <i class="bi bi-speedometer2 me-1"></i>

                            Panel

                        </a>

                    </li>

                <% } %>


                <!-- =================================================
                     CLIENTE
                     ================================================= -->

                <% if ("Cliente".equalsIgnoreCase(rolActualNav)) { %>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/cliente/favoritos.jsp") %>">

                            <i class="bi bi-heart me-1"></i>

                            Favoritos

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/cliente/mis_citas.jsp") %>">

                            <i class="bi bi-calendar-check me-1"></i>

                            Mis citas

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/cliente/mis_solicitudes.jsp") %>">

                            <i class="bi bi-file-earmark-text me-1"></i>

                            Mis solicitudes

                        </a>

                    </li>

                <% } %>


                <!-- =================================================
                     INMOBILIARIA
                     ================================================= -->

                <% if ("Inmobiliaria".equalsIgnoreCase(rolActualNav)) { %>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/agente/propiedades.jsp") %>">

                            <i class="bi bi-building me-1"></i>

                            Propiedades

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/agente/citas.jsp") %>">

                            <i class="bi bi-calendar-week me-1"></i>

                            Agenda

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/agente/solicitudes.jsp") %>">

                            <i class="bi bi-inboxes me-1"></i>

                            Solicitudes

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/agente/reportes.jsp") %>">

                            <i class="bi bi-graph-up me-1"></i>

                            Reportes

                        </a>

                    </li>

                <% } %>


                <!-- =================================================
                     ADMINISTRADOR
                     ================================================= -->

                <% if ("Administrador".equalsIgnoreCase(rolActualNav)) { %>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/admin/usuarios.jsp") %>">

                            <i class="bi bi-people me-1"></i>

                            Usuarios

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/admin/catalogos.jsp") %>">

                            <i class="bi bi-tags me-1"></i>

                            Catálogos

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="<%= response.encodeURL(ctxNav + "/admin/auditoria.jsp") %>">

                            <i class="bi bi-journal-text me-1"></i>

                            Auditoría

                        </a>

                    </li>

                <% } %>

            </ul>


            <!-- =====================================================
                 USUARIO AUTENTICADO
                 ===================================================== -->

            <% if (usuarioAutenticadoNav) { %>

                <div class="d-flex align-items-center gap-2">

                    <span class="navbar-text text-white">

                        <i class="bi bi-person-circle me-1"></i>

                        <%= nombreEscNav %>

                        <span class="badge bg-primary ms-1">

                            <%= rolEscNav %>

                        </span>

                    </span>


                    <a
                        class="btn btn-outline-light btn-sm"
                        href="<%= response.encodeURL(ctxNav + "/logout.jsp") %>">

                        <i class="bi bi-box-arrow-right me-1"></i>

                        Salir

                    </a>

                </div>


            <!-- =====================================================
                 VISITANTE
                 ===================================================== -->

            <% } else { %>

                <div class="d-flex align-items-center gap-2">

                    <a
                        class="btn btn-outline-light btn-sm"
                        href="<%= response.encodeURL(ctxNav + "/login.jsp") %>">

                        <i class="bi bi-box-arrow-in-right me-1"></i>

                        Ingresar

                    </a>


                    <a
                        class="btn btn-light btn-sm"
                        href="<%= response.encodeURL(ctxNav + "/registro.jsp") %>">

                        <i class="bi bi-person-plus me-1"></i>

                        Crear cuenta

                    </a>

                </div>

            <% } %>

        </div>

    </div>

</nav>


<!-- ============================================================
     CONTENIDO DE LA PÁGINA
     ============================================================ -->

<div class="container pb-5 pt-4">