<%@ page import="java.sql.Connection, java.sql.DriverManager, java.sql.SQLException" %>

<%!
    private static final String DB_URL =
        "jdbc:mysql://b2corje15vpwt7w6v5te-mysql.services.clever-cloud.com:3306/b2corje15vpwt7w6v5te"
        + "?useSSL=true"
        + "&serverTimezone=UTC"
        + "&characterEncoding=UTF-8"
        + "&useUnicode=true";

    private static final String DB_USER = "umjdxdso9l2ccyme";

    private static final String DB_PASSWORD = "Fef8sOCaX0PMx9UEZTy4";

    static {
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
        } catch (ClassNotFoundException e) {
            System.err.println(
                "No se encontró el driver de MySQL: " + e.getMessage()
            );
        }
    }

    public static Connection abrirConexion() throws SQLException {
        return DriverManager.getConnection(
            DB_URL,
            DB_USER,
            DB_PASSWORD
        );
    }

    public static void cerrar(Object... recursos) {
        if (recursos == null) {
            return;
        }

        for (Object recurso : recursos) {
            if (recurso instanceof java.sql.ResultSet) {
                try {
                    ((java.sql.ResultSet) recurso).close();
                } catch (Exception e) {
                }

            } else if (recurso instanceof java.sql.Statement) {
                try {
                    ((java.sql.Statement) recurso).close();
                } catch (Exception e) {
                }

            } else if (recurso instanceof java.sql.Connection) {
                try {
                    ((java.sql.Connection) recurso).close();
                } catch (Exception e) {
                }
            }
        }
    }

    public static void deshacer(Connection con) {
        if (con != null) {
            try {
                con.rollback();
            } catch (SQLException e) {
                System.err.println(
                    "Error en rollback: " + e.getMessage()
                );
            }
        }
    }
%>